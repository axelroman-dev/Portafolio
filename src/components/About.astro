---
import type { Portfolio } from "../lib/types";
interface Props {
    data: Portfolio;
}
const { data } = Astro.props;
const a = data.about;
const l = data.links;
---

<section class="about section" aria-label="Sobre mí">
    <div class="about-main">
        <div
            class="kicker"
            data-i18n="about.kicker"
            data-i18n-es={a.kicker.es}
            data-i18n-en={a.kicker.en}
        >
            {a.kicker.es}
        </div>
        <h2
            class="about-title"
            data-i18n="about.title"
            data-i18n-es={a.title.es}
            data-i18n-en={a.title.en}
        >
            {a.title.es}
        </h2>
        <p data-i18n="about.p1" data-i18n-es={a.paragraphs.es[0]} data-i18n-en={a.paragraphs.en[0]}>
            {a.paragraphs.es[0]}
        </p>
        <p data-i18n="about.p2" data-i18n-es={a.paragraphs.es[1]} data-i18n-en={a.paragraphs.en[1]}>
            {a.paragraphs.es[1]}
        </p>
    </div>
    <div class="links">
        <div
            class="kicker"
            data-i18n="links.kicker"
            data-i18n-es={l.kicker.es}
            data-i18n-en={l.kicker.en}
        >
            {l.kicker.es}
        </div>
        <div class="links-list">
            {l.items.map((item) => (
                <a class="link-row" href={item.href}>
                    <span>{item.label}</span>
                    <span class="meta">{item.meta}</span>
                </a>
            ))}
        </div>
    </div>
</section>
