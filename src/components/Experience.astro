---
import type { Portfolio } from "../lib/types";
interface Props {
    data: Portfolio;
}
const { data } = Astro.props;
const e = data.experience;
---

<section class="exp" aria-label="Experiencia">
    <div
        class="kicker"
        data-i18n="experience.kicker"
        data-i18n-es={e.kicker.es}
        data-i18n-en={e.kicker.en}
    >
        {e.kicker.es}
    </div>
    <h2
        class="exp-title"
        data-i18n="experience.title"
        data-i18n-es={e.title.es}
        data-i18n-en={e.title.en}
    >
        {e.title.es}
    </h2>
    <ol class="exp-list">
        {e.items.map((row, idx) => (
            <li class="exp-item">
                <div
                    class="exp-year"
                    data-i18n={`experience.${idx}.year`}
                    data-i18n-es={row.year.es}
                    data-i18n-en={row.year.en}
                >
                    {row.year.es}
                </div>
                <div class="exp-body">
                    <h3
                        class="exp-role"
                        data-i18n={`experience.${idx}.role`}
                        data-i18n-es={row.role.es}
                        data-i18n-en={row.role.en}
                    >
                        {row.role.es}
                    </h3>
                    <div
                        class="exp-where"
                        data-i18n={`experience.${idx}.where`}
                        data-i18n-es={row.where.es}
                        data-i18n-en={row.where.en}
                    >
                        {row.where.es}
                    </div>
                    {row.summary && (
                        <p
                            class="exp-summary"
                            data-i18n={`experience.${idx}.summary`}
                            data-i18n-es={row.summary.es}
                            data-i18n-en={row.summary.en}
                        >
                            {row.summary.es}
                        </p>
                    )}
                    {row.highlights && (
                        <ul class="exp-highlights">
                            {row.highlights.es.map((text, i) => (
                                <li
                                    data-i18n={`experience.${idx}.highlights.${i}`}
                                    data-i18n-es={text}
                                    data-i18n-en={row.highlights?.en[i] ?? text}
                                >
                                    {text}
                                </li>
                            ))}
                        </ul>
                    )}
                    {row.tags && (
                        <div class="project-tags">
                            {row.tags.map((tag) => (
                                <span class="project-tag">{tag}</span>
                            ))}
                        </div>
                    )}
                </div>
            </li>
        ))}
    </ol>
</section>
