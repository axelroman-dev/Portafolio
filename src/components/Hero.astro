---
import type { Portfolio } from "../lib/types";
import { publicFileExists } from "../lib/portfolio";
interface Props {
    data: Portfolio;
}
const { data } = Astro.props;
const p = data.profile;
const ui = data.ui;
const photo = publicFileExists(p.photo) ? p.photo : null;
const cv = data.links.items.find((item) => item.id === "cv");
const cvHref = cv && publicFileExists(cv.href) ? cv.href : null;
---

<section class={photo ? "hero has-photo" : "hero"} id="top" aria-label="Hero">
    <div class="hero-main">
        <div
            class="kicker"
            data-i18n="profile.kicker"
            data-i18n-es={p.kicker.es}
            data-i18n-en={p.kicker.en}
        >
            {p.kicker.es}
        </div>
        <h1 class="hero-name">{p.title}</h1>
        <div class="divider-2"></div>
        <div
            class="hero-role"
            data-i18n="profile.role"
            data-i18n-es={p.role.es}
            data-i18n-en={p.role.en}
        >
            {p.role.es}
        </div>
        <p
            class="hero-tagline"
            data-i18n="profile.tagline"
            data-i18n-es={p.tagline.es}
            data-i18n-en={p.tagline.en}
        >
            {p.tagline.es}
        </p>
        <div class="hero-ctas">
            <a
                href="#proyectos"
                class="btn btn-primary"
                data-i18n="ui.ctaWork"
                data-i18n-es={ui.ctaWork.es}
                data-i18n-en={ui.ctaWork.en}
            >
                {ui.ctaWork.es}
            </a>
            {cvHref && (
                <a
                    href={cvHref}
                    class="btn btn-secondary"
                    download
                    data-i18n="ui.ctaCv"
                    data-i18n-es={ui.ctaCv.es}
                    data-i18n-en={ui.ctaCv.en}
                >
                    {ui.ctaCv.es}
                </a>
            )}
            {/* <a
                href="#contacto"
                class="btn btn-secondary"
                data-i18n="ui.ctaHire"
                data-i18n-es={ui.ctaHire.es}
                data-i18n-en={ui.ctaHire.en}
            >
                {ui.ctaHire.es}
            </a> */}
        </div>
    </div>
    {photo && (
        <div class="hero-photo">
            <img src={photo} alt={p.title} width="480" height="600" />
        </div>
    )}
</section>
