---
import { Image } from "astro:assets";
import type { Portfolio } from "../lib/types";
import { getScreenshot, publicFileExists } from "../lib/portfolio";
interface Props {
    data: Portfolio;
}
const { data } = Astro.props;
const proj = data.projects;
const ui = data.ui;
---

<section id="proyectos" aria-label="Proyectos">
    <div class="projects-header">
        <div class="projects-header-meta">
            <div
                class="kicker"
                data-i18n="projects.kicker"
                data-i18n-es={proj.kicker.es}
                data-i18n-en={proj.kicker.en}
            >
                {proj.kicker.es}
            </div>
            <h2
                class="projects-title"
                data-i18n="projects.title"
                data-i18n-es={proj.title.es}
                data-i18n-en={proj.title.en}
            >
                {proj.title.es}
            </h2>
        </div>
        <div class="filters" role="group" aria-label="Filtros por tecnología">
            {proj.filters.map((f, i) => (
                <button
                    type="button"
                    class={`filter-btn${i === 0 ? " active" : ""}`}
                    data-filter={f}
                    aria-pressed={i === 0 ? "true" : "false"}
                >
                    {f === "all" ? ui.all.es : f}
                </button>
            ))}
        </div>
    </div>

    <div class="projects-grid">
        {proj.items.map((p) => {
            const links = (p.links ?? []).map((l) => ({
                href: l.href,
                label: typeof l.label === "string" ? { es: l.label, en: l.label } : l.label,
                external: /^https?:\/\//.test(l.href),
            }));
            const shots = (p.screenshots ?? []).map((s) => ({
                image: getScreenshot(s.src),
                alt: s.alt,
            }));
            const cover = shots[0];
            return (
                <article
                    class="project-card"
                    data-project
                    data-id={p.id}
                    data-tags={p.tags.join("|")}
                >
                    {cover && (
                        <button
                            type="button"
                            class="project-shot"
                            data-gallery-open={p.id}
                            aria-label={`Ver capturas de ${p.name}`}
                            data-i18n-attr="aria-label:shots"
                            data-i18n-aria-label-es={`Ver capturas de ${p.name}`}
                            data-i18n-aria-label-en={`View screenshots of ${p.name}`}
                        >
                            <Image
                                src={cover.image}
                                alt=""
                                widths={[400, 640, 960]}
                                sizes="(min-width: 1060px) 33vw, (min-width: 700px) 50vw, 100vw"
                                loading="lazy"
                            />
                            {shots.length > 1 && (
                                <span class="project-shot-count">+{shots.length - 1}</span>
                            )}
                        </button>
                    )}
                    {cover && (
                        <template data-gallery-src={p.id}>
                            {shots.map((s) => (
                                <Image
                                    src={s.image}
                                    alt={s.alt.es}
                                    data-alt-es={s.alt.es}
                                    data-alt-en={s.alt.en}
                                    widths={[800, 1280, 1920]}
                                    sizes="(min-width: 1240px) 1200px, 100vw"
                                    loading="eager"
                                />
                            ))}
                        </template>
                    )}
                    <div class="project-head">
                        {publicFileExists(p.icon) ? (
                            <div class={p.iconFill ? "project-icon fill" : "project-icon"}>
                                <img src={p.icon} alt="" width="66" height="66" loading="lazy" />
                            </div>
                        ) : p.initials?.trim() ? (
                            <div class="project-initials">{p.initials.trim()}</div>
                        ) : null}
                        <div class="project-meta">
                            <div class="project-name">{p.name}</div>
                            <div
                                class="project-category"
                                data-i18n={`project.${p.id}.category`}
                                data-i18n-es={p.category.es}
                                data-i18n-en={p.category.en}
                            >
                                {p.category.es}
                            </div>
                            <div class="project-tags">
                                {p.tags.map((tag) => (
                                    <span class="project-tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                    <p
                        class="project-desc"
                        data-i18n={`project.${p.id}.desc`}
                        data-i18n-es={p.desc.es}
                        data-i18n-en={p.desc.en}
                    >
                        {p.desc.es}
                    </p>
                    {links.length > 0 && (
                        <div class="project-links">
                            {links.map((l, i) => (
                                <a
                                    class="project-link"
                                    href={l.href}
                                    target={l.external ? "_blank" : undefined}
                                    rel={l.external ? "noopener noreferrer" : undefined}
                                    data-i18n={`project.${p.id}.link${i}`}
                                    data-i18n-es={l.label.es}
                                    data-i18n-en={l.label.en}
                                >
                                    {l.label.es}
                                </a>
                            ))}
                        </div>
                    )}
                </article>
            );
        })}
        <div
            class="empty projects-empty"
            style="display: none;"
            data-i18n="empty"
            data-i18n-es="Sin proyectos para este filtro."
            data-i18n-en="No projects for this filter."
        >
            Sin proyectos para este filtro.
        </div>
    </div>

    <dialog class="gallery" data-gallery aria-label="Capturas del proyecto">
        <div class="gallery-bar">
            <span class="gallery-counter" data-gallery-counter></span>
            <button
                type="button"
                class="gallery-btn"
                data-gallery-close
                aria-label="Cerrar"
                data-i18n-attr="aria-label:close"
                data-i18n-aria-label-es="Cerrar"
                data-i18n-aria-label-en="Close"
            >
                ✕
            </button>
        </div>
        <div class="gallery-stage">
            <button
                type="button"
                class="gallery-btn gallery-prev"
                data-gallery-prev
                aria-label="Captura anterior"
                data-i18n-attr="aria-label:prev"
                data-i18n-aria-label-es="Captura anterior"
                data-i18n-aria-label-en="Previous screenshot"
            >
                ←
            </button>
            <figure class="gallery-figure">
                <div class="gallery-image" data-gallery-image></div>
                <figcaption class="gallery-caption" data-gallery-caption></figcaption>
            </figure>
            <button
                type="button"
                class="gallery-btn gallery-next"
                data-gallery-next
                aria-label="Siguiente captura"
                data-i18n-attr="aria-label:next"
                data-i18n-aria-label-es="Siguiente captura"
                data-i18n-aria-label-en="Next screenshot"
            >
                →
            </button>
        </div>
    </dialog>
</section>
