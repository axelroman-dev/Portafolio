---
import type { Portfolio } from "../lib/types";
interface Props {
    data: Portfolio;
}
const { data } = Astro.props;
const proj = data.projects;
const ui = data.ui;
---

<section id="proyectos" aria-label="Proyectos">
    <div class="projects-header">
        <div class="projects-header-meta">
            <div
                class="kicker"
                data-i18n="projects.kicker"
                data-i18n-es={proj.kicker.es}
                data-i18n-en={proj.kicker.en}
            >
                {proj.kicker.es}
            </div>
            <h2
                class="projects-title"
                data-i18n="projects.title"
                data-i18n-es={proj.title.es}
                data-i18n-en={proj.title.en}
            >
                {proj.title.es}
            </h2>
        </div>
        <div class="filters" role="group" aria-label="Filtros por tecnología">
            {proj.filters.map((f, i) => (
                <button
                    type="button"
                    class={`filter-btn${i === 0 ? " active" : ""}`}
                    data-filter={f}
                    aria-pressed={i === 0 ? "true" : "false"}
                >
                    {f === "all" ? ui.all.es : f}
                </button>
            ))}
        </div>
    </div>

    <div class="projects-grid">
        {proj.items.map((p) => {
            const hasRepo = !!p.repo;
            const hasUrl = !!p.url;
            const repoLabel = ui.repo.es;
            const urlLabel = ui.web.es;
            return (
                <article
                    class="project-card"
                    data-project
                    data-id={p.id}
                    data-tags={p.tags.join("|")}
                >
                    <div class="project-head">
                        <div class="project-initials">{p.initials}</div>
                        <div class="project-meta">
                            <div class="project-name">{p.name}</div>
                            <div
                                class="project-category"
                                data-i18n={`project.${p.id}.category`}
                                data-i18n-es={p.category.es}
                                data-i18n-en={p.category.en}
                            >
                                {p.category.es}
                            </div>
                            <div class="project-tags">
                                {p.tags.map((tag) => (
                                    <span class="project-tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                    <p
                        class="project-desc"
                        data-i18n={`project.${p.id}.desc`}
                        data-i18n-es={p.desc.es}
                        data-i18n-en={p.desc.en}
                    >
                        {p.desc.es}
                    </p>
                    {(hasRepo || hasUrl) && (
                        <div class="project-links">
                            {hasRepo && (
                                <a
                                    class="project-link"
                                    href={p.repo!}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n={`project.${p.id}.repo`}
                                    data-i18n-es={repoLabel}
                                    data-i18n-en={ui.repo.en}
                                >
                                    {repoLabel}
                                </a>
                            )}
                            {hasUrl && (
                                <a
                                    class="project-link"
                                    href={p.url!}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    data-i18n={`project.${p.id}.web`}
                                    data-i18n-es={urlLabel}
                                    data-i18n-en={ui.web.en}
                                >
                                    {urlLabel}
                                </a>
                            )}
                        </div>
                    )}
                </article>
            );
        })}
        <div
            class="empty projects-empty"
            style="display: none;"
            data-i18n="empty"
            data-i18n-es="Sin proyectos para este filtro."
            data-i18n-en="No projects for this filter."
        >
            Sin proyectos para este filtro.
        </div>
    </div>
</section>
