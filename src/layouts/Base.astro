---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Axel Roman · Ingeniero en Sistemas y Desarrollador FullStack",
    description = "Portafolio de Axel Roman — Ingeniero en Sistemas y Desarrollador FullStack. Proyectos en Java, C#, Flutter y JavaScript, e infraestructura self-hosted en Linux.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/img/profile.jpg", Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=swap"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="es_MX" />
        <meta property="og:locale:alternate" content="en_US" />
        <meta name="twitter:card" content="summary" />
        <meta name="theme-color" content="#10913f" />
        <script is:inline>
            // Apply persisted theme before paint to avoid flash.
            (function () {
                try {
                    var t = localStorage.getItem("theme");
                    if (t === "dark" || t === "light") {
                        document.documentElement.setAttribute("data-theme", t);
                    }
                } catch (e) {}
            })();
        </script>
    </head>
    <body>
        <slot />
        <script>
            import { initPortfolio } from "../scripts/portfolio";
            initPortfolio();
        </script>
    </body>
</html>
